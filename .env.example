# Database Configuration (PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://mou_user:CHANGE_PASSWORD@localhost:5432/mou_dashboard

# Google Sheets API Credentials (Optional - for live sync)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_SPREADSHEET_ID=19u0zXbaZqOdBNkuNEuIHys7UXggGN73-

# Email Configuration (SMTP) - REQUIRED for expiry notifications
# For Gmail:
# 1. Enable 2FA at: https://myaccount.google.com/security
# 2. Generate App Password at: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password (no spaces)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=YOUR-16-CHAR-APP-PASSWORD
SMTP_FROM=your-email@gmail.com
SMTP_TO=recipient@example.com

# Flask Security - REQUIRED for production
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-THIS-TO-RANDOM-32-CHAR-HEX

# Environment
FLASK_ENV=production
